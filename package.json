{
  "name": "noname-general-extension",
  "version": "1.0.0",
  "description": "《无名杀》武将扩展开发技能包：7200+ 技能语义检索 + 带指纹校验的增量知识库 + 扩展注册修复",
  "type": "module",
  "bin": {
    "nge-search": "scripts/skill-search.mjs",
    "nge-index": "scripts/build-index.mjs",
